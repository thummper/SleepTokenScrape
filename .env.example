# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# The Gmail account that sends the alerts.
GMAIL_ADDRESS=you@gmail.com

# A Google App Password, NOT your normal Gmail password.
# Requires 2-Step Verification on the account, then:
#   https://myaccount.google.com/apppasswords
# Paste the 16 characters. Spaces are fine; Google shows it as "abcd efgh ijkl mnop".
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Where alerts are delivered. Can be the same as GMAIL_ADDRESS.
NOTIFY_ADDRESS=you@gmail.com

# How often to check. HH:MM:SS. Every 15 minutes is polite and plenty for merch drops.
POLL_INTERVAL=00:15:00

# Set true for the first run to confirm SMTP works without waiting for a drop.
# The test email only sends when a baseline is being established (i.e. no state yet).
SEND_STARTUP_TEST_EMAIL=true

# Only change these if you are not using Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
