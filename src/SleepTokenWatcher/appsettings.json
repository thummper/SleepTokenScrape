{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": true,
        "SingleLine": true
      }
    }
  },
  "Watcher": {
    "Stores": [
      {
        "Key": "sleep-token",
        "Name": "Sleep Token UK Store",
        "Platform": "Shopify",
        "BaseUrl": "https://storeuk.sleep-token.com",
        "CollectionHandle": "all-products",
        "CurrencySymbol": "£",
        // Kept from the single-store version so the existing baseline carries over.
        "StateFileName": "state.json"
      },
      {
        "Key": "york-ghost-merchants",
        "Name": "York Ghost Merchants",
        "Platform": "Squarespace",
        "BaseUrl": "https://www.yorkghostmerchants.com",
        "CollectionHandle": "shop",
        "CurrencySymbol": "£",
        // Every product is hidden between drops, so an empty shop is normal, not a glitch.
        "AllowEmptyCatalog": true
      }
    ],
    "PollInterval": "00:15:00",
    "StateDirectory": "/data",
    "HeartbeatFilePath": "/data/heartbeat",
    "DisplayTimeZone": "Europe/London",
    "SendStartupTestEmail": false,
    "MaxPages": 20
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "FromName": "Merch Store Watcher"
  }
}
