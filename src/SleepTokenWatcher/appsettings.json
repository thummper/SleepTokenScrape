{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": true,
        "SingleLine": true
      }
    }
  },
  "Watcher": {
    "StoreBaseUrl": "https://storeuk.sleep-token.com",
    "CollectionHandle": "all-products",
    "PollInterval": "00:15:00",
    "StateFilePath": "/data/state.json",
    "HeartbeatFilePath": "/data/heartbeat",
    "DisplayTimeZone": "Europe/London",
    "CurrencySymbol": "£",
    "SendStartupTestEmail": false,
    "MaxPages": 20
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "FromName": "Sleep Token Store Watcher"
  }
}
